# ══════════════════════════════════════════════════════════════════
#  LinkHub — Django Project .gitignore
#  Project layout:
#    linkhub/          ← Django config (settings, urls, wsgi, asgi)
#    users/            ← Users app  (Profile, Skill models)
#    projects/         ← Projects app (Project, Review, Tag models)
#    templates/        ← Global HTML templates
#    static/           ← Source static assets (CSS, JS, images)
#      images/         ← Static images committed to repo
#      images/profiles/← USER UPLOADED profile pics — NOT committed
#    staticfiles/      ← collectstatic output — NOT committed
#    env/              ← Virtual environment — NOT committed
#    db.sqlite3        ← Local SQLite database — NOT committed
# ══════════════════════════════════════════════════════════════════


# ── Python bytecode ───────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd
*.so


# ── Virtual environment ───────────────────────────────────────────
# Created with: python -m venv env
env/
venv/
.venv/
ENV/


# ── Django ────────────────────────────────────────────────────────

# Local SQLite database (use a real DB in production)
db.sqlite3
db.sqlite3-journal

# Django log files
*.log

# Local settings override (never commit secrets)
local_settings.py

# Django migrations compiled cache (keep migration .py files)
# migrations/__pycache__/ is already covered by __pycache__/ above


# ── User uploaded media files ─────────────────────────────────────
# MEDIA_ROOT = static/images  (set in linkhub/settings.py)
# User profile pictures land in static/images/profiles/
# Project featured images land in static/images/  (root)
# Source assets (default.jpg, icon.svg, pattern.jpg, linkhub_logo.svg)
# are committed — only ignore the dynamically generated uploads:
static/images/profiles/
# Uncomment the line below if project images also pollute static/images/
# static/images/*.jpg  # project featured images


# ── collectstatic output ──────────────────────────────────────────
# Generated by: python manage.py collectstatic
# Served by WhiteNoise in production (already in INSTALLED_APPS)
staticfiles/


# ── Secrets / Environment variables ──────────────────────────────
# Store SECRET_KEY, DB passwords, API keys here — never commit
.env
.env.*
*.env
# Allow the example template (contains no real secrets)
!.env.example


# ── Distribution / Packaging ─────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST


# ── Testing ──────────────────────────────────────────────────────
.coverage
.coverage.*
htmlcov/
.pytest_cache/
.tox/
nosetests.xml
coverage.xml


# ── IDE / Editor ─────────────────────────────────────────────────
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~


# ── OS generated files ────────────────────────────────────────────
# macOS
.DS_Store
.AppleDouble
.LSOverride

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# Linux
*~


# ── Jupyter (if ML/analysis notebooks added later) ───────────────
.ipynb_checkpoints/
*.ipynb


# ── Misc ─────────────────────────────────────────────────────────
*.bak
*.tmp
*.orig
pip-log.txt
pip-delete-this-directory.txt
